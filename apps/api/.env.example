NODE_ENV=development
PORT=4000

# MySQL 8 — required at boot (mysql2 / Drizzle). See docs/database.md
# mysql://USER:PASSWORD@127.0.0.1:3306/sinfinity
DATABASE_URL=mysql://root:password@127.0.0.1:3306/sinfinity

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional comma-separated emails treated as platform super-admins
# SUPER_ADMIN_EMAILS=admin@sinfinity.cd

# Comma-separated origins (web :3000, admin :3001, pos :3002)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
