NODE_ENV=development
PORT=4000

# Database (MySQL 8) — discrete vars (preferred). See docs/database.md
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=sinfinity

# Legacy alternative (optional if DATABASE_* above are set):
# DATABASE_URL=mysql://root:unit-test-only@127.0.0.1:3306/sinfinity

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-please-change-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_PASSWORD_RESET_TTL=1h
# Aliases also accepted: JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN

# Optional comma-separated emails treated as platform super-admins
# SUPER_ADMIN_EMAILS=admin@sinfinity.cd

# Comma-separated origins (web :3000, admin :3001, pos :3002)
# Alias CORS_ORIGIN also accepted
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# File storage (local disk for development)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
